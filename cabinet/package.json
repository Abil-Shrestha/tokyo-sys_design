{
  "name": "cabinet",
  "productName": "Cabinet",
  "version": "0.1.0",
  "description": "A private, local-first home for everything you want to remember: images, links, articles, notes and quotes.",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:electron": "node scripts/dev.mjs --electron",
    "build": "vite build && node scripts/build-node.mjs",
    "start": "electron .",
    "serve": "node --disable-warning=ExperimentalWarning dist/server/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@mozilla/readability": "^0.6.0",
    "fastify": "^5.12.5",
    "linkedom": "^0.18.13",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
